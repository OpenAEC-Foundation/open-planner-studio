{
  // Typecheck-config voor de code BUITEN src/: `scripts/`, `tests/` en `integrations/` (de Claude
  // Desktop-bundel, die ook op Node draait).
  //
  // Waarom dit bestaat (bevinding K10b): de hoofd-tsconfig heeft `include: ["src"]`, dus die
  // ~19k regels TypeScript werden nooit door tsc gezien. Ze draaien via esbuild, en esbuild
  // STRIPT types zonder ze te controleren — een `any`, een typefout of dode code overleefde
  // daar dus onopgemerkt (zo kon `expect: any` in tests/planning/harness.ts blijven staan).
  //
  // Dezelfde strictness als de hoofdconfig: `strict`, `noUnusedLocals`, `noUnusedParameters`
  // erven ongewijzigd mee. Alleen `types` wordt gezet — deze code draait op Node, src/ in de
  // browser.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Node-globals (process, Buffer, node:*-modules) horen bij scripts/ en tests/, niet bij src/.
    "types": ["node"]
  },
  // Ambient globals moeten expliciet mee: `include` volgt imports wél, maar pikt losse
  // .d.ts-declaratiebestanden niet automatisch op (idem tests/planning/tsconfig.check.json).
  // (`src/vite-env.d.ts` levert `__APP_VERSION__` en `import.meta.env`, die de geïmporteerde
  // src-modules gebruiken; `file-system-access.d.ts` de FSA-typen achter fileAccess/webBackend.)
  "include": ["scripts", "tests", "integrations", "src/vite-env.d.ts", "src/types/file-system-access.d.ts"]
}
