{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "/usr/share/fonts" }, { "path": "/usr/share/fonts/**" },
        { "path": "/usr/local/share/fonts" }, { "path": "/usr/local/share/fonts/**" },
        { "path": "/System/Library/Fonts" }, { "path": "/System/Library/Fonts/**" },
        { "path": "/Library/Fonts" }, { "path": "/Library/Fonts/**" },
        { "path": "C:/Windows/Fonts" }, { "path": "C:/Windows/Fonts/**" }
      ]
    },
    {
      "identifier": "fs:allow-open",
      "allow": [
        { "path": "/usr/share/fonts" }, { "path": "/usr/share/fonts/**" },
        { "path": "/usr/local/share/fonts" }, { "path": "/usr/local/share/fonts/**" },
        { "path": "/System/Library/Fonts" }, { "path": "/System/Library/Fonts/**" },
        { "path": "/Library/Fonts" }, { "path": "/Library/Fonts/**" },
        { "path": "C:/Windows/Fonts" }, { "path": "C:/Windows/Fonts/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "/usr/share/fonts" }, { "path": "/usr/share/fonts/**" },
        { "path": "/usr/local/share/fonts" }, { "path": "/usr/local/share/fonts/**" },
        { "path": "/System/Library/Fonts" }, { "path": "/System/Library/Fonts/**" },
        { "path": "/Library/Fonts" }, { "path": "/Library/Fonts/**" },
        { "path": "C:/Windows/Fonts" }, { "path": "C:/Windows/Fonts/**" }
      ]
    },
    "store:default",
    "os:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "clipboard-manager:allow-write-image",
    "core:image:allow-new"
  ]
}
