{
  "name": "open-planner-studio",
  "private": true,
  "version": "2026.9.0",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src",
    "test": "npm run test:planning && npm run test:library && npm run test:mcp && npm run test:dev-server && npm run test:browser",
    "test:planning": "bash tests/planning/run.sh",
    "test:library": "bash tests/library/run.sh",
    "test:mcp": "bash tests/mcp/run.sh",
    "test:dev-server": "node --test tests/dev-server/*.test.mjs && bash tests/dev-server/integration.sh",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:browser:x11": "node tests/browser/x11-xer-evidence.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run verify:examples && npm run verify:docs && npm run verify:i18n && npm run verify:store-boundaries && npm run verify:gantt-boundaries && npm run verify:cycles",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "tauri build",
    "bump": "node scripts/bump-version.js",
    "gen:examples": "node scripts/run-ts.mjs scripts/generate-examples.ts",
    "verify:examples": "node scripts/run-ts.mjs scripts/verify-examples.ts",
    "verify:docs": "node scripts/run-ts.mjs scripts/verify-docs.ts",
    "verify:i18n": "node scripts/i18n-diff.mjs",
    "verify:release-highlights": "node scripts/release-highlights.mjs",
    "verify:store-boundaries": "node scripts/verify-store-boundaries.mjs",
    "verify:gantt-boundaries": "node scripts/verify-gantt-boundaries.mjs",
    "verify:cycles": "node scripts/verify-cycles.mjs",
    "verify:audit": "npm audit --audit-level=high",
    "publish:wiki": "node scripts/publish-wiki.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "bidi-js": "^1.0.3",
    "i18next": "^25.8.13",
    "immer": "11.1.4",
    "lucide-react": "^0.575.0",
    "modern-screenshot": "^4.7.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
